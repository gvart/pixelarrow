# Static responses of the landing (ADR-0007): never framed. The Worker sets the same on its own responses.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff

# Fingerprinted build output (fonts) never changes under its name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Clips, stills, soldier sprites and kit frames keep their names across re-renders, so they revalidate after a day.
/video/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/art/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/men/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/ui/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
