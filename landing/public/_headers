# Static responses of the landing (ADR-0007): never framed. The Worker sets the same on its own responses.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff

# Fingerprinted build output (fonts) never changes under its name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Hero layers keep their names across art re-renders, so they revalidate after a day.
/hero/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Clips, posters and class busts keep their names across re-encodes, so they revalidate after a day.
/video/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/classes/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
