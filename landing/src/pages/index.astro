---
// pixelarrow.app: the sections in STRUCTURE.md order. V6-LAND-01 composes them; later LAND stories
// fill the section components and never edit this file. The .divider lines between sections are
// static here; V6-LAND-03 makes them draw themselves (style the class, no markup change needed).
import Base from '../layouts/Base.astro';
import Classes from '../components/sections/Classes.astro';
import Clips from '../components/sections/Clips.astro';
import ClosingCta from '../components/sections/ClosingCta.astro';
import Faq from '../components/sections/Faq.astro';
import Features from '../components/sections/Features.astro';
import Hero from '../components/sections/Hero.astro';
import Modes from '../components/sections/Modes.astro';
import Stats from '../components/sections/Stats.astro';
---
<Base>
  <Hero />
  <Features />
  <div class="divider" aria-hidden="true"></div>
  <Classes />
  <div class="divider" aria-hidden="true"></div>
  <Modes />
  <div class="divider" aria-hidden="true"></div>
  <Stats />
  <div class="divider" aria-hidden="true"></div>
  <Clips />
  <div class="divider" aria-hidden="true"></div>
  <Faq />
  <ClosingCta />
</Base>
