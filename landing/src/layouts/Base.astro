---
// The page shell: head (fonts, metadata), skip link, header, <main id="content">, footer.
// Only Cinzel 700 is preloaded: it sets the hero headline, the likely LCP text.
import '../styles/global.css';
import cinzelUrl from '../fonts/cinzel-700-latin.woff2?url';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import SkipLink from '../components/SkipLink.astro';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}
const props = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={cinzelUrl} as="font" type="font/woff2" crossorigin />
    <Seo {...props} />
    <slot name="head" />
  </head>
  <body>
    <SkipLink />
    <Header />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
