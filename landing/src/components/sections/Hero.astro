---
// The hero: a looping battle behind the title card (mockup D). On phones the card sits at the foot
// of the clip (LAND_phone_1).
import Clip from '../Clip.astro';
import { PLAY_URL } from '../../site';
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <Clip ids={['war-battle']} fallback="/art/keyart-battle.webp" label="Hoplites and archers clash with a blue-cloaked army before a stone fortress." eager />
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="hero__card frame-band">
    <h1 class="hero__title" id="hero-title">Pixelarrow</h1>
    <p class="hero__sub">Play your way</p>
    <p class="hero__tag">Trade. Build. Conquer. Hunt.</p>
    <a class="play play--big" href={PLAY_URL}>Play</a>
    <p class="hero__note">An online war of mythic ancient Greece, in your browser.</p>
  </div>
</section>

<style is:global>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(560px, 92svh, 900px);
    padding: calc(var(--header-h) + 32px) var(--gutter) 48px;
    border-bottom: 4px solid var(--night);
    isolation: isolate;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse 60% 55% at 50% 48%, rgb(14 9 7 / 0.35), transparent 70%),
      linear-gradient(to bottom, rgb(14 9 7 / 0.55), transparent 22%, transparent 75%, rgb(14 9 7 / 0.7));
    pointer-events: none;
  }
  .hero__card {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: 6px;
    width: fit-content;
    max-width: 100%;
    padding: 20px 40px 22px;
    text-align: center;
    background-color: rgb(23 16 13 / 0.92);
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.55);
  }
  .hero__title {
    font-size: var(--fs-hero);
    letter-spacing: 0.06em;
  }
  .hero__sub {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.6vw, 2rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .hero__tag {
    margin-bottom: 14px;
    color: var(--muted);
    font-size: 1.125rem;
    letter-spacing: 0.02em;
  }
  .hero__note {
    margin-top: 12px;
    color: var(--muted);
    font-size: var(--fs-caption);
  }
  /* The toggle sits clear of the card's shade on the clip's corner. */
  .hero .clip__toggle {
    z-index: 3;
  }
  @media (max-width: 767px) {
    .hero {
      align-items: end;
      min-height: max(600px, 100svh);
      padding-bottom: 24px;
    }
    .hero__card {
      width: 100%;
      padding: 16px 12px 18px;
    }
    .hero__title {
      letter-spacing: 0.03em;
    }
    .hero .clip__toggle {
      top: calc(var(--header-h) + 12px);
      bottom: auto;
    }
  }
</style>
