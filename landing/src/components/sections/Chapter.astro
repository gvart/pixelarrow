---
// One chapter band (mockup D): a full-width looping clip with a text card on one side, the sides
// alternating down the page. On phones the card sits over the foot of the clip (LAND_phone_1).
import Clip from '../Clip.astro';

interface Props {
  id: string;
  title: string;
  clips: string[];
  fallback: string;
  label: string;
  side: 'left' | 'right';
}
const { id, title, clips, fallback, label, side } = Astro.props;
---
<section class:list={['chapter', `chapter--${side}`]} id={id} aria-labelledby={`${id}-title`}>
  <Clip ids={clips} fallback={fallback} label={label} />
  <div class="chapter__shade" aria-hidden="true"></div>
  <div class="chapter__inner container">
    <div class="chapter__card frame-band">
      <h2 class="chapter__title" id={`${id}-title`}>{title}</h2>
      <p class="chapter__text"><slot /></p>
    </div>
  </div>
</section>

<style is:global>
  .chapter {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(320px, 31vw, 520px);
    border-bottom: 4px solid var(--night);
    isolation: isolate;
  }
  /* A terracotta rule between bands, like the seams between the mockup's panels. */
  .chapter::after {
    content: '';
    position: absolute;
    inset: auto 0 -3px;
    z-index: 2;
    height: 2px;
    background: var(--line);
    pointer-events: none;
  }
  .chapter__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .chapter--left .chapter__shade {
    background: linear-gradient(to right, rgb(14 9 7 / 0.5), transparent 45%);
  }
  .chapter--right .chapter__shade {
    background: linear-gradient(to left, rgb(14 9 7 / 0.5), transparent 45%);
  }
  .chapter__inner {
    position: relative;
    z-index: 2;
    display: flex;
    pointer-events: none;
  }
  .chapter--right .chapter__inner {
    justify-content: flex-end;
  }
  .chapter__card {
    width: min(100%, 410px);
    padding: 14px 24px 18px;
    text-align: center;
    background-color: rgb(23 16 13 / 0.93);
    box-shadow: 0 10px 32px rgb(0 0 0 / 0.5);
    pointer-events: auto;
  }
  .chapter__title {
    margin-bottom: 8px;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
  }
  .chapter__text {
    color: var(--ink);
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  @media (max-width: 767px) {
    .chapter {
      align-items: flex-end;
      min-height: 0;
      aspect-ratio: auto;
      padding-top: min(78vw, 360px);
      padding-bottom: 20px;
    }
    .chapter__shade,
    .chapter--left .chapter__shade,
    .chapter--right .chapter__shade {
      background: linear-gradient(to bottom, transparent 45%, rgb(14 9 7 / 0.65));
    }
    .chapter__inner,
    .chapter--right .chapter__inner {
      justify-content: center;
    }
    .chapter .clip__toggle {
      top: 12px;
      bottom: auto;
    }
  }
</style>
