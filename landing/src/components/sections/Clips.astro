---
// Gameplay clips (#clips), STRUCTURE.md §6. Four longer takes G1-G4 recorded from the real game
// (docs/v6/ASSET_LOG.md, P5-VIDEO); captions say only what each take shows. A 2x2 grid from 768 px,
// a horizontal snap reel on phones (one clip in view, so one plays). Clip.astro and clips.ts are shared
// with Modes, unchanged. One VideoObject per clip, built from the same list, so the JSON-LD never
// describes a clip the page does not show.
import Clip from '../Clip.astro';
import { SITE_URL } from '../../site';

const CLIPS = [
  {
    id: 'G1', seconds: 8,
    title: 'A formation breaks',
    line: 'Companion cavalry rides round the Celts’ flank and charges. Their line wavers, then runs.',
    label: 'A battle: Companion cavalry charges the flank of a Celtic line, which breaks and routs.',
  },
  {
    id: 'G2', seconds: 8,
    title: 'The war map',
    line: 'The shared seasonal map: towns, rivers and a rival army on the march.',
    label: 'The war map: a pass over towns, rivers and mountains toward a rival army on the march.',
  },
  {
    id: 'G3', seconds: 8,
    title: 'A ranked duel',
    line: 'A phalanx set to the shield wall holds as the two duel armies clash.',
    label: 'A ranked duel: a phalanx in shield wall holds as two duel armies clash.',
  },
  {
    id: 'G4', seconds: 5,
    title: 'At the forge',
    line: 'At a town’s smith, one stat line of an item is reforged.',
    label: 'The smith in a town’s services: an item’s stat line is reforged, with its card in full.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': CLIPS.map((c) => ({
    '@type': 'VideoObject',
    name: c.title,
    description: c.line,
    thumbnailUrl: `${SITE_URL}/video/${c.id}-poster.webp`,
    contentUrl: `${SITE_URL}/video/${c.id}.webm`,
    uploadDate: '2026-10-13',
    duration: `PT${c.seconds}S`,
    isPartOf: { '@id': `${SITE_URL}/#game` },
  })),
};
---
<section class="section section--night clips" id="clips" aria-labelledby="clips-title">
  <div class="container">
    <header class="section__head">
      <h2 id="clips-title" class="section__title">See it move</h2>
      <p class="section__lead">Recorded from the game.</p>
    </header>
    <ul class="clips__reel" role="list" aria-label="Gameplay clips">
      {CLIPS.map((c) => (
        <li class="take">
          <Clip id={c.id} width={960} height={540} label={c.label} />
          <h3 class="take__title">{c.title}</h3>
          <p class="take__line">{c.line}</p>
        </li>
      ))}
    </ul>
  </div>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>

<style>
  .clips__reel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s12) var(--s8);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .take {
    display: grid;
    align-content: start;
    gap: var(--s2);
  }
  .take :global(.clip) {
    margin-bottom: var(--s2);
    border: 1px solid var(--stone-edge);
    border-bottom: 3px solid #0c0a08;
    border-radius: var(--radius);
  }
  .take__title {
    font-size: 1.25rem;
  }
  .take__line {
    max-width: 46ch;
    color: var(--cream-muted);
  }

  /* Phones: a reel that bleeds to the screen edges and snaps one take at a time, with the next one
     peeking in so it reads as scrollable. Only the take in view is half visible, so only it plays. */
  @media (max-width: 767px) {
    .clips__reel {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 86%;
      gap: var(--s4);
      margin-inline: calc(-1 * var(--gutter));
      padding: 0 var(--gutter) var(--s4);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: thin;
      scrollbar-color: var(--stone-edge) transparent;
    }
    .take {
      scroll-snap-align: start;
    }
  }
</style>
