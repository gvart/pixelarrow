---
// The footer: the wordmark, the legal pages and the copyright.
---
<footer class="footer">
  <div class="footer__inner container">
    <a class="footer__mark" href="#top">Pixelarrow</a>
    <nav class="footer__links" aria-label="Legal">
      <ul>
        <li><a href="/terms">Terms of service</a></li>
        <li><a href="/privacy">Privacy policy</a></li>
      </ul>
    </nav>
    <p class="footer__copy">© 2026 Pixelarrow</p>
  </div>
</footer>

<style is:global>
  .footer {
    border-top: 1px solid var(--rule);
    background: var(--night);
    padding-bottom: max(24px, env(safe-area-inset-bottom));
  }
  .footer__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 8px 24px;
    padding-top: 24px;
  }
  .footer__mark {
    grid-column: 2;
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .footer__links {
    grid-column: 3;
    justify-self: end;
  }
  .footer__links ul {
    display: flex;
    gap: 4px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer__links a {
    display: inline-block;
    padding: 10px 0;
    color: var(--muted);
    font-size: var(--fs-caption);
    text-decoration: none;
  }
  .footer__copy {
    grid-column: 1;
    grid-row: 1;
    color: var(--muted);
    font-size: var(--fs-caption);
  }
  @media (hover: hover) and (pointer: fine) {
    .footer__links a:hover {
      color: var(--ink);
      text-decoration: underline;
    }
  }
  @media (max-width: 767px) {
    .footer__inner {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
    .footer__mark,
    .footer__links,
    .footer__copy {
      grid-column: 1;
      grid-row: auto;
      justify-self: center;
    }
  }
</style>
