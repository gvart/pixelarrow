---
// A looping gameplay clip that fills its parent (the hero and the chapter bands). Clips live in
// public/video/ as <id>.{webm,mp4}, an optional <id>-hd.{webm,mp4} for wide screens and a poster
// <id>-poster.{avif,webp}. The first id whose files exist at build time is used; with none, the band
// shows the fallback still and no video, so the page builds and reads well either way.
// The <video> has no source in the markup: scripts/clips.ts sets it when the clip nears the viewport,
// plays it muted while it is in view and pauses it when it is not. Reduced motion or data saver keep
// the poster until the visitor presses Play.
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  /** File stems in public/video/, best first (for example ['war-siege', 'war-battle']). */
  ids: string[];
  /** A still in public/ shown when no clip or poster exists. */
  fallback: string;
  /** What the clip shows: the poster's alt text and the button labels. */
  label: string;
  /** The hero: its poster loads at once. */
  eager?: boolean;
}
const { ids, fallback, label, eager = false } = Astro.props;

const dir = join(process.cwd(), 'public', 'video');
const has = (f: string) => existsSync(join(dir, f));
const id = ids.find((i) => has(`${i}.webm`) || has(`${i}.mp4`));
const files = (stem: string) => [`${stem}.webm`, `${stem}.mp4`].filter(has).map((f) => `/video/${f}`);
const sources = id ? files(id) : [];
const hd = id ? files(`${id}-hd`) : [];
const poster = id && has(`${id}-poster.webp`) ? `/video/${id}-poster.webp` : fallback;
const avif = id && has(`${id}-poster.avif`) ? `/video/${id}-poster.avif` : null;
const loading = eager ? 'eager' : 'lazy';
---
<div class="clip" data-clip={id ? '' : undefined} data-sources={sources.join(' ')} data-hd={hd.join(' ') || undefined} data-label={label}>
  <picture class="clip__poster">
    {avif && <source type="image/avif" srcset={avif} />}
    <img src={poster} alt={label} loading={loading} fetchpriority={eager ? 'high' : undefined} decoding="async" />
  </picture>
  {id && (
    <>
      <video class="clip__video" muted loop playsinline disablepictureinpicture preload="none" aria-hidden="true" tabindex="-1"></video>
      <button class="clip__toggle" type="button" hidden aria-label={`Play clip: ${label}`}>
        <svg class="clip__glyph clip__glyph--play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5.5v13l10.5-6.5Z" /></svg>
        <svg class="clip__glyph clip__glyph--pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
      </button>
    </>
  )}
</div>

<style is:global>
  .clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--night);
  }
  .clip__poster,
  .clip__poster img,
  .clip__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
  .clip__poster img,
  .clip__video {
    image-rendering: pixelated;
  }
  /* The video stays invisible until a frame is painted, so the poster never blinks. */
  .clip__video {
    opacity: 0;
    transition: opacity 400ms var(--ease-out);
  }
  .clip.is-shown .clip__video {
    opacity: 1;
  }
  /* Play / pause, so the motion can always be stopped (WCAG 2.2.2): the kit's button in a corner. */
  .clip__toggle {
    position: absolute;
    right: 12px;
    bottom: 12px;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border-style: solid;
    border-width: 6px;
    border-image: url('/ui/button-active@2x.png') 6 fill / 6px stretch;
    background: none;
    color: #fff0d8;
    cursor: pointer;
    image-rendering: pixelated;
    opacity: 0.75;
    transition: opacity var(--dur) var(--ease-out);
  }
  .clip__toggle:hover,
  .clip__toggle:focus-visible {
    opacity: 1;
  }
  .clip__glyph {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }
  .clip__glyph--pause,
  .clip.is-playing .clip__glyph--play {
    display: none;
  }
  .clip.is-playing .clip__glyph--pause {
    display: block;
  }
</style>

<script>
  import { initClips } from '../scripts/clips';
  initClips();
</script>
