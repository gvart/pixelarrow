---
// Top navigation (STRUCTURE.md "Global chrome"): the wordmark, five section anchors and a small
// "Play" button. Fixed; transparent over the hero, solid once the page scrolls (a scroll timeline
// where the browser has one, a solid bar where it does not). Under 768 px the anchors fold into a
// native popover menu and "Play" stays visible. Over the hero, "Play" is the outline style so the
// hero's "Play in browser" is the only terracotta button in view (ART_DIRECTION §4).
import { NAV, PLAY_URL } from '../site';
---
<header class="nav">
  <div class="nav__bar container">
    <a class="nav__mark" href="#top" aria-label="Pixelarrow, back to top">Pixelarrow</a>
    <nav class="nav__links" aria-label="Sections">
      <ul>
        {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div class="nav__actions">
      <a class="btn btn--small nav__play" href={PLAY_URL}>Play</a>
      <button class="nav__menu-btn" type="button" popovertarget="nav-menu" aria-label="Sections menu">
        <svg width="20" height="14" viewBox="0 0 20 14" aria-hidden="true">
          <path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </div>
  </div>
  <nav id="nav-menu" class="nav__menu" popover aria-label="Sections">
    <ul>
      {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </nav>
</header>

<script is:inline>
  // A popover stays open after a link inside it is followed; close it so the section is in view.
  document.getElementById('nav-menu').addEventListener('click', function (e) {
    if (e.target.closest('a')) this.hidePopover();
  });
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--nav-h);
    background: rgb(16 13 11 / 0.92);
    border-bottom: 1px solid rgb(70 61 51 / 0.6);
  }
  .nav__bar {
    display: flex;
    align-items: center;
    gap: var(--s8);
    height: 100%;
  }
  .nav__mark {
    flex: none;
    color: var(--cream);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .nav__links {
    margin-left: auto;
  }
  .nav__links ul,
  .nav__menu ul {
    display: flex;
    gap: var(--s2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav__links a {
    display: block;
    padding: var(--s3) var(--s3);
    color: var(--cream-sec);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--dur-micro) var(--ease-out);
  }
  .nav__actions {
    display: flex;
    align-items: center;
    gap: var(--s2);
  }
  .nav__play {
    background: var(--terra);
    border-color: #c25a3a;
  }
  .nav__menu-btn {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid rgb(240 227 194 / 0.35);
    border-radius: var(--radius);
    background: transparent;
    color: var(--cream);
    cursor: pointer;
  }

  .nav__menu {
    inset: var(--nav-h) 0 auto;
    width: 100%;
    margin: 0;
    padding: var(--s2) var(--gutter) var(--s4);
    border: 0;
    border-bottom: 1px solid var(--stone-edge);
    background: var(--night);
    color: var(--cream);
  }
  .nav__menu ul {
    flex-direction: column;
    gap: 0;
  }
  .nav__menu a {
    display: block;
    padding: var(--s3) 0;
    color: var(--cream);
    font-size: 1.0625rem;
    text-decoration: none;
    border-bottom: 1px solid rgb(70 61 51 / 0.5);
  }
  .nav__menu li:last-child a {
    border-bottom: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav__links a:hover {
      color: var(--cream);
    }
  }

  @media (max-width: 767px) {
    .nav__links {
      display: none;
    }
    .nav__actions {
      margin-left: auto;
    }
    .nav__menu-btn {
      display: grid;
    }
    .nav__mark {
      font-size: 1.0625rem;
    }
  }
  @media (min-width: 768px) {
    .nav__menu {
      display: none;
    }
  }
  @media (min-width: 768px) and (max-width: 959px) {
    .nav__bar {
      gap: var(--s4);
    }
    .nav__links a {
      padding-inline: var(--s2);
    }
  }

  /* Over the hero the bar is clear and "Play" is outlined; both settle as the hero scrolls away.
     Colour only, no movement, so it is not gated on reduced motion. */
  @supports (animation-timeline: scroll()) {
    .nav {
      /* Longhands only: a minified shorthand would swallow the timeline. */
      animation-name: nav-solid;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
      animation-range: 0 40vh;
    }
    .nav__play {
      animation-name: nav-play;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
      animation-range: 50vh 90vh;
    }
  }
  @keyframes nav-solid {
    from {
      background-color: rgb(16 13 11 / 0);
      border-bottom-color: rgb(70 61 51 / 0);
    }
  }
  @keyframes nav-play {
    from {
      background-color: rgb(16 13 11 / 0.35);
      border-color: rgb(240 227 194 / 0.75);
    }
  }
</style>
