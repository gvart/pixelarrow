{
  "name": "pixelarrow-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ../wrangler.jsonc --persist-to .wrangler/state",
    "migrate:local": "wrangler d1 migrations apply pixelarrow --local --config ../wrangler.jsonc --persist-to .wrangler/state",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dry-run": "wrangler deploy --dry-run --config ../wrangler.jsonc --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  }
}
