{
  "name": "pixelarrow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shots": "node scripts/dev/screenshots.mjs",
    "balance": "node scripts/dev/balance.mjs",
    "balance:ladder": "node scripts/dev/ladderParity.mjs",
    "fonts:metrics": "node scripts/dev/font-metrics.mjs",
    "regression": "node scripts/regression/run.mjs",
    "sheets:pack": "node scripts/art/pack/cli.mjs --dev",
    "bench:war": "node scripts/war/bench.mjs",
    "balance:war": "node scripts/war/balance.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-sc": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "phaser": "^3.90.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "playwright": "1.56",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
