{
  "name": "pixelarrow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shots": "node scripts/dev/screenshots.mjs",
    "balance": "node scripts/dev/balance.mjs",
    "fonts:metrics": "node scripts/dev/font-metrics.mjs",
    "map:build": "node scripts/buildMap.ts maps-src/westmed.json",
    "icons": "python3 -I scripts/dev/icons/icons.py"
  },
  "dependencies": {
    "@fontsource/cormorant-sc": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "playwright": "1.56",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
