{
  "name": "pixelarrow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench:war": "node scripts/war/bench.mjs",
    "perf:war": "vitest run --config vitest.perf.config.ts",
    "balance:war": "node scripts/war/balance.mjs",
    "play:war": "node scripts/war/play.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-sc": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "phaser": "^3.90.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "playwright": "1.56",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
