# Build-time variables for the game client (vite). Copy to .env.local for local builds; never commit secrets here.
# The Turnstile SITE key is public. This is Cloudflare's published always-pass testing key; a dev build
# (npm run dev) uses it when the variable is unset. Production: the repo variable TURNSTILE_SITE_KEY.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
